# Sao chép thành .env.local (Next.js đọc tự động, file này không commit)
# URL backend FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000
# Site key Cloudflare Turnstile (công khai). Bỏ trống → không hiện captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Google Client ID (công khai), cùng giá trị với GOOGLE_CLIENT_ID của backend. Bỏ trống → ẩn nút Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
