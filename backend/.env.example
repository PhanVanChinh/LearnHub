# Copy thành .env rồi sửa
# Sinh key ngẫu nhiên:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./learnhub.db
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
# Tài khoản admin tạo ở lần chạy đầu — ĐỔI khi deploy thật
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Gửi email xác thực. Bỏ trống RESEND_API_KEY → chế độ dev: mã OTP in ra terminal backend, không gửi mail thật.
# Lấy key tại https://resend.com → API Keys. MAIL_FROM dùng onboarding@resend.dev khi chưa có domain riêng
# (chỉ gửi được tới email đăng ký tài khoản Resend); có domain đã xác minh thì đổi thành "LearnHub <noreply@ten-mien.com>".
RESEND_API_KEY=
MAIL_FROM=LearnHub <onboarding@resend.dev>
OTP_EXPIRE_MINUTES=10
# URL frontend, dùng để tạo link đặt lại mật khẩu trong email
FRONTEND_URL=http://localhost:3000

# Chống lạm dụng
# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile → Add site). Bỏ trống → không bắt captcha.
TURNSTILE_SECRET_KEY=
# Bật khi deploy sau proxy (Render/Railway...) để rate limit đọc đúng IP khách từ X-Forwarded-For
TRUST_PROXY_HEADERS=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Nút "Xuất bản" trong admin → GitHub Actions build lại site tĩnh. Tạo token tại
# https://github.com/settings/personal-access-tokens (fine-grained, chỉ repo này, quyền Contents: Read and write).
GITHUB_TOKEN=
GITHUB_REPO=PhanVanChinh/LearnHub

# Đăng nhập Google: Client ID loại "Web application" từ Google Cloud Console → APIs & Services → Credentials.
# Authorized JavaScript origins: http://localhost:3000 và domain frontend thật. Bỏ trống → ẩn nút Google.
GOOGLE_CLIENT_ID=
